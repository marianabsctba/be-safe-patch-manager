# Human console authentication.
# On the FIRST startup only, provide a bootstrap administrator.
# After the first admin exists in PostgreSQL, these two bootstrap values may be cleared.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password-at-least-14-characters

# Server-side opaque session lifetime. Default: 8 hours.
AUTH_SESSION_TTL_SECONDS=28800

# Optional emergency-only admin token. Leave empty for normal operation.
# If configured, use a strong random value of at least 32 characters.
BREAK_GLASS_ADMIN_TOKEN=

# Shared token used only for initial agent enrollment.
ENROLLMENT_TOKEN=replace-with-a-random-enrollment-token-at-least-32-characters

# Base compose keeps this false for local/lab use.
# Production overlay forces it to true behind the mTLS reverse proxy.
AGENT_MTLS_REQUIRED=false

# Endpoint is considered online when its last heartbeat is newer than this.
AGENT_ONLINE_SECONDS=300

# Fleet compatibility. Base/lab mode observes compatibility but does not block.
# Production overlay forces compatibility enforcement on.
AGENT_MIN_VERSION=0.13.0
AGENT_MIN_PROTOCOL=2
AGENT_ENFORCE_COMPATIBILITY=false

# Signed agent release distribution.
# Requires a release built with scripts/agent-release.py and the matching
# Ed25519 public key provisioned at deploy/update-trust/agent-update-public.pem.
AGENT_UPDATE_ENABLED=false

# Agent self-update approvals are intentionally short-lived.
# A pending activation older than this will be refused before claim.
AGENT_UPDATE_APPROVAL_TTL_SECONDS=1800

# A heartbeat must be this recent before a Linux endpoint can be included
# in a new agent-update activation or rollout approval.
AGENT_UPDATE_MAX_HEARTBEAT_AGE_SECONDS=900

# PostgreSQL used by docker compose.
POSTGRES_DB=patchmgr
POSTGRES_USER=patchmgr
POSTGRES_PASSWORD=replace-with-a-random-db-password-at-least-32-characters

# Job execution leases. A claimed-but-not-started job may return to the queue
# after the short lease. A running job never requeues automatically; if its
# lease expires it becomes stalled and requires administrative review.
JOB_CLAIM_LEASE_SECONDS=300
JOB_RUNNING_LEASE_SECONDS=7200

# Vulnerability remediation SLA, in hours by severity.
# Only findings with status=open consume SLA. accepted_risk, false_positive,
# not_detected and remediated remain visible but are excluded from breach counts.
VULNERABILITY_SLA_CRITICAL_HOURS=72
VULNERABILITY_SLA_HIGH_HOURS=168
VULNERABILITY_SLA_MEDIUM_HOURS=720
VULNERABILITY_SLA_LOW_HOURS=2160
VULNERABILITY_SLA_INFO_HOURS=4320
VULNERABILITY_SLA_UNKNOWN_HOURS=720
VULNERABILITY_SLA_DUE_SOON_HOURS=24

# Optional Greenbone / OpenVAS integration.
# Keep credentials only in the real .env. Never commit the populated .env.
GREENBONE_ENABLED=false
GREENBONE_TRANSPORT=tls
GREENBONE_HOST=127.0.0.1
GREENBONE_PORT=9390
GREENBONE_SOCKET=/run/gvmd/gvmd.sock
GREENBONE_USERNAME=
GREENBONE_PASSWORD=
GREENBONE_CA_FILE=
GREENBONE_CERT_FILE=
GREENBONE_KEY_FILE=
GREENBONE_KEY_PASSWORD=
GREENBONE_TIMEOUT=60
GREENBONE_SYNC_INTERVAL=900
GREENBONE_RESULT_FILTER=rows=-1 min_qod=70
GREENBONE_TASK_FILTER=rows=-1
GREENBONE_REPORT_ID=
# If enabled, absent findings become not_detected, never automatically remediated.
GREENBONE_RECONCILE_ABSENT=false

# Maximum time after an activation job completes for the new Linux agent
# version to confirm itself through heartbeat.
AGENT_ACTIVATION_CONFIRM_TIMEOUT_SECONDS=900
